# lobsterbot — environment variables
# Copy this file to .env and fill in your values.

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram user IDs allowed to use this bot.
# Your primary ID is 828807562 — add any co-operators after a comma.
TELEGRAM_ALLOWED_USER_IDS=828807562

# Optional: friendly host label shown in /status output.
# Defaults to `hostname` if unset.
LOBSTERBOT_HOST_LABEL=OpenClaw

# Optional: cap on command output characters sent back to Telegram
# (Telegram hard limit is 4096; we stay a bit under for code-block framing).
LOBSTERBOT_MAX_OUTPUT=3800

# Optional: tag logs with this, useful if you run multiple instances.
LOBSTERBOT_INSTANCE=openclaw
